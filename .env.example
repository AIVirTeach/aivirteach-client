# Switch this single value between "local" and "remote", then restart npm run dev.
NEXT_PUBLIC_BACKEND_MODE=local

# Backend URLs. Do not include trailing slashes.
NEXT_PUBLIC_LOCAL_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REMOTE_API_BASE_URL=https://aivirteach-server.vercel.app/api/v1

# Development-only target for the same-origin /guacamole proxy.
# The target must serve Guacamole at /guacamole and support WebSocket upgrades.
GUACAMOLE_PROXY_TARGET=http://127.0.0.1:8080

# Must match the server's GUACAMOLE_PUBLIC_PATH and the public reverse proxy.
NEXT_PUBLIC_GUACAMOLE_PUBLIC_PATH=/guacamole/

# Desktop release builds load the deployed frontend at this HTTPS URL.
# This is a public URL, never a service token or a URL containing credentials.
AIVIRTEACH_DESKTOP_APP_URL=https://learn.example.com/

# Localhost-only escape hatch for testing a release build against a local server.
# Never enable this for a distributed build.
AIVIRTEACH_DESKTOP_ALLOW_HTTP_LOCALHOST=0
