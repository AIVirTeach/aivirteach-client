{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIVirTeach RDP Client",
  "version": "0.2.0",
  "identifier": "com.aivirteach.rdp-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIVirTeach · Linux xrdp 实验环境",
        "width": 1360,
        "height": 850,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
